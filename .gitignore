# AOS workspace folders — never commit user workspaces to this repo
/*-aos/

# Common OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
.claude/

# Logs that may contain personal data
*.log

# Temp/scratch/zip files
*.tmp
*.bak
*.zip

# Python bytecode cache
__pycache__/
*.py[cod]

# Internal documents
internal/

# Local sync baseline (runbook §36.2/§36.3) — machine bookkeeping, recomputable
# from current file contents by `scripts/sync-state.py record`, and different for
# every contributor. Never a source of truth; correctness lives in CI.
.openaos-sync-state.json
